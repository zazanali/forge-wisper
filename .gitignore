# =============================================================================
# Forge Wisper - Comprehensive .gitignore for GitHub
# =============================================================================

# --- Rust & Cargo Build Artifacts ---
/target/
**/target/
**/*.rs.bk
*.pdb
*.d
*.rlib
*.rmeta

# --- Node, TypeScript & Frontend Bundles ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/
*.local
.turbo/
coverage/
*.lcov

# --- Tauri Application Builds & Installers ---
apps/desktop/src-tauri/target/
**/src-tauri/target/
*.exe
*.msi
*.app
*.dmg
*.deb
*.rpm
*.AppImage

# --- Local AI Models & Heavy Binary Weights (Download on demand) ---
models/*.bin
models/*.gguf
models/*.pt
models/*.onnx
**/*.bin
**/*.gguf
**/*.pt
**/*.onnx
!models/README.md

# --- Temporary Audio Captures & Caches ---
*.wav
*.mp3
*.aac
*.ogg
*.flac
*.pcm
recordings/
captures/
audio_cache/

# --- SQLite Databases & Cache Files ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
forge_wisper_history.db

# --- Secrets, API Keys & Certificates (NEVER COMMIT) ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt

# --- OS & System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.swp
*.bak
*~

# --- IDE & Editor Configs ---
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Internal Specifications & PRD Documents ---
*PRD*
*.PRD.md
*.prd.md

# --- Stitch & Agent Tooling ---
.stitch/
.agents/
.gemini/
scratch/


