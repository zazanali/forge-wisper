{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Wisper",
  "version": "0.1.0",
  "identifier": "com.alizazan.forgewisper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forge Wisper",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "label": "recorder",
        "title": "Forge Wisper Recorder",
        "url": "/#recorder",
        "width": 320,
        "height": 72,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ali Zazan",
    "copyright": "Copyright © 2026 Ali Zazan",
    "category": "DeveloperTool",
    "shortDescription": "AI Voice-to-Text and Smart Dictation Desktop Application",
    "longDescription": "High-performance, privacy-first desktop voice-to-text application created by Ali Zazan.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "installMode": "currentUser"
      }
    }
  }
}
